{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maliyati.app/schemas/smart-action-v1.json",
  "title": "Maliyati Smart Input",
  "description": "Canonical structured output accepted by Maliyati Input by script.",
  "oneOf": [
    {
      "$ref": "#/$defs/action"
    },
    {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    {
      "type": "object",
      "required": [
        "actions"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "action": {
      "oneOf": [
        {
          "$ref": "#/$defs/add"
        },
        {
          "$ref": "#/$defs/edit"
        },
        {
          "$ref": "#/$defs/delete"
        },
        {
          "$ref": "#/$defs/settle"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Income",
        "Expense",
        "Credit",
        "Debt",
        "Transfer"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "moneyFields": {
      "type": "object",
      "properties": {
        "amount_usd": {
          "type": "number",
          "minimum": 0
        },
        "amount_lbp": {
          "type": "number",
          "minimum": 0
        },
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "type": "string",
          "enum": [
            "USD",
            "LBP"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "amount_usd"
          ],
          "properties": {
            "amount_usd": {
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "required": [
            "amount_lbp"
          ],
          "properties": {
            "amount_lbp": {
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "required": [
            "amount",
            "currency"
          ]
        }
      ]
    },
    "transactionProperties": {
      "type": "object",
      "required": [
        "date",
        "status",
        "title",
        "category",
        "payment_method"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "amount_usd": {
          "type": "number",
          "minimum": 0
        },
        "amount_lbp": {
          "type": "number",
          "minimum": 0
        },
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "type": "string",
          "enum": [
            "USD",
            "LBP"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "payment_method": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "My Wallet",
            "Whish Money",
            "Service"
          ]
        },
        "wallet_id": {
          "type": "string"
        },
        "destination_wallet_id": {
          "type": "string"
        },
        "payment_timing": {
          "type": "string",
          "enum": [
            "",
            "Paid Now",
            "On Credit"
          ]
        },
        "settlement_status": {
          "type": "string",
          "enum": [
            "",
            "open",
            "partial",
            "settled"
          ]
        },
        "notes": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "const": "script"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/moneyFields"
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "Transfer"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "wallet_id",
              "destination_wallet_id"
            ]
          }
        }
      ]
    },
    "add": {
      "allOf": [
        {
          "$ref": "#/$defs/transactionProperties"
        },
        {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "const": "add_transaction"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "edit": {
      "allOf": [
        {
          "$ref": "#/$defs/transactionProperties"
        },
        {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "const": "edit_transaction"
            },
            "target_id": {
              "type": "string",
              "minLength": 1
            },
            "target_title": {
              "type": "string",
              "minLength": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "target_id"
              ]
            },
            {
              "required": [
                "target_title"
              ]
            }
          ],
          "additionalProperties": true
        }
      ]
    },
    "delete": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "const": "delete_transaction"
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "target_title": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "target_id"
          ]
        },
        {
          "required": [
            "target_title"
          ]
        }
      ],
      "additionalProperties": false
    },
    "settle": {
      "type": "object",
      "required": [
        "action",
        "date",
        "payment_method"
      ],
      "properties": {
        "action": {
          "const": "settle_transaction"
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "target_title": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "amount_usd": {
          "type": "number",
          "minimum": 0
        },
        "amount_lbp": {
          "type": "number",
          "minimum": 0
        },
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "type": "string",
          "enum": [
            "USD",
            "LBP"
          ]
        },
        "exchange_rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "payment_method": {
          "type": "string",
          "enum": [
            "My Wallet",
            "Whish Money"
          ]
        },
        "source": {
          "type": "string",
          "const": "script"
        }
      },
      "anyOf": [
        {
          "required": [
            "target_id"
          ]
        },
        {
          "required": [
            "target_title"
          ]
        }
      ],
      "dependentRequired": {
        "amount": [
          "currency"
        ]
      },
      "additionalProperties": false
    }
  }
}

